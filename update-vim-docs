#!/usr/bin/env bash

set -euo pipefail
set -x

repository_directory=$(cd "$(dirname "$0")" && pwd)
output_file=$(mktemp)

cleanup() {
  rm -f "${output_file}"
}
trap cleanup EXIT

docker run --rm \
  --mount \
    "type=bind,src=${repository_directory},target=/YouCompleteMe,readonly" \
  --workdir /YouCompleteMe \
  python:3.12 \
  bash -c '
    set -eu
    git clone --depth 1 \
      https://github.com/ycm-core/vim-tools /tmp/vim-tools >&2
    python3 -m pip install --disable-pip-version-check \
      -r /tmp/vim-tools/requirements.txt >&2
    exec python3 /tmp/vim-tools/html2vimdoc.py \
      -f youcompleteme README.md
  ' > "${output_file}"

mv "${output_file}" "${repository_directory}/doc/youcompleteme.txt"
